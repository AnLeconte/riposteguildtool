# ============================================================
# Production .env — copier vers .env sur le VPS et compléter
# ============================================================

# ── Domaine & TLS (Caddy / Let's Encrypt) ────────────────────
DOMAIN=riposteguildtool.fr
ACME_EMAIL=admin@riposteguildtool.fr

# ── Database ─────────────────────────────────────────────────
DB_PASSWORD=replace-with-strong-password

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=replace-with-openssl-rand-base64-32
FRONTEND_URL=https://riposteguildtool.fr

# ── Sims ─────────────────────────────────────────────────────
SIM_CONCURRENCY=2

# ── Blizzard / Battle.net OAuth ──────────────────────────────
# https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BNET_REDIRECT_URI=https://riposteguildtool.fr/api/auth/bnet/callback

# ── WarcraftLogs API v2 ──────────────────────────────────────
# https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# ── Discord OAuth (login + apply form) ───────────────────────
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://riposteguildtool.fr/api/auth/discord/callback
DISCORD_APPLY_REDIRECT_URI=https://riposteguildtool.fr/api/auth/discord-apply/callback

# ── Discord Bot (slash commands, recap, etc.) ────────────────
DISCORD_BOT_TOKEN=
DISCORD_BOT_API_KEY=replace-with-internal-api-key
DISCORD_GUILD_ID=
DISCORD_ABSENCE_CHANNEL_ID=
DISCORD_APPLY_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# ── Guild metadata ───────────────────────────────────────────
GUILD_NAME=Riposte
GUILD_REALM=hyjal
GUILD_REGION=eu

# ── AI (optional) ────────────────────────────────────────────
GROQ_API_KEY=
