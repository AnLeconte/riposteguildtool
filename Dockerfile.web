# ── Stage 1: Build frontend ───────────────────────────────────────────────────
FROM node:22-slim AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/simc-engine ./packages/simc-engine
COPY packages/web ./packages/web

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @wow-simc/shared build 2>/dev/null || true
RUN pnpm --filter @wow-simc/simc-engine build 2>/dev/null || true
RUN pnpm --filter web build

# ── Stage 2: Serve with Caddy (auto-HTTPS via Let's Encrypt) ─────────────────
FROM caddy:2-alpine

COPY --from=builder /app/packages/web/dist /usr/share/caddy
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
