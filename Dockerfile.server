# ── Stage 1: Build SimC from source (ARM compatible) ──────────────────────────
# Must match runtime base (node:22-slim → Debian Bookworm) so glibc/libstdc++
# symbols line up — building on a newer base produces a binary that won't run.
FROM debian:bookworm AS simc-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git build-essential cmake libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 --branch midnight https://github.com/simulationcraft/simc.git \
    && cd simc \
    && cmake -B build -DBUILD_GUI=OFF -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j$(nproc) \
    && cp build/simc /usr/local/bin/simc

# ── Stage 2: Build app ───────────────────────────────────────────────────────
FROM node:22-slim AS app-builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/simc-engine ./packages/simc-engine
COPY packages/server ./packages/server

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @wow-simc/shared build 2>/dev/null || true
RUN pnpm --filter @wow-simc/simc-engine build 2>/dev/null || true
RUN pnpm --filter @wow-simc/server build 2>/dev/null || true

# ── Stage 3: Production runtime ──────────────────────────────────────────────
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4 ca-certificates ffmpeg curl \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
       -o /usr/local/bin/yt-dlp \
    && chmod +x /usr/local/bin/yt-dlp \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy SimC binary
COPY --from=simc-builder /usr/local/bin/simc /usr/local/bin/simc

WORKDIR /app
COPY --from=app-builder /app ./

ENV NODE_ENV=production
ENV SIMC_PATH=/usr/local/bin/simc
ENV PORT=3001

EXPOSE 3001

CMD ["pnpm", "--filter", "server", "start"]
