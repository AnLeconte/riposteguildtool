{
  "name": "riposte-guild-tool",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter @wow-simc/server dev",
    "dev:web": "pnpm --filter @wow-simc/web dev",
    "dev": "pnpm run dev:server & pnpm run dev:web",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @wow-simc/server db:generate",
    "db:migrate": "pnpm --filter @wow-simc/server db:migrate"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["bcrypt"]
  }
}
