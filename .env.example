# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riposte_guild_tool

# Redis
REDIS_URL=redis://localhost:6379

# SimC
SIMC_PATH=/usr/local/bin/simc

# Server
PORT=3001
JWT_SECRET=change-me-in-production

# Blizzard API
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Battle.net OAuth (redirect URI must match Blizzard Developer Portal)
BNET_REDIRECT_URI=http://localhost:5173/auth/callback

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ABSENCE_CHANNEL_ID=
DISCORD_RECAP_CHANNEL_ID=

# Guild config (for slash commands & weekly recap)
GUILD_NAME=Riposte
GUILD_REALM=hyjal
GUILD_REGION=eu

# Groq AI (free tier - https://console.groq.com)
GROQ_API_KEY=
